# =============================================================================
# Music-Data-Pipeline — Environment Variables
# Copy this file to .env and fill in the values that are relevant to you.
# =============================================================================

# --- API key for the inference services called by the pipeline ---
# (for ALM / ASR / LLM endpoints such as the Qwen3-Omni series, MusicFlamingo,
#  or other audio-language models exposed through an OpenAI-compatible gateway)
INF_API_KEY=

# --- Runner-managed GPU budget ---
PIPELINE_GPU_MAX_MEMORY_GIB=0  # 0 = unlimited
VLLM_GPU_HEADROOM_GIB=4
ASR_FORCED_ALIGNER_RESERVE_GIB=8
ASR_MIN_VLLM_MEMORY_GIB=8
PIPELINE_GPU_WAIT_TIMEOUT=60
PIPELINE_GPU_WAIT_POLL=10
CPU_MIR_WORKERS=8

# --- HuggingFace mirror (optional, used by model download scripts) ---
# HF_ENDPOINT=https://hf-mirror.com

# --- Fast music gate (versioned fixed config; defaults are repository-local) ---
FAST_GATE_CONFIG=
PANNS_REPO=

# --- External ALM scheduling ---
# Keep enabled when ALM is a remote service. Disable if it shares the ASR GPU.
PARALLEL_ASR_WITH_EXTERNAL_ALM=1

# --- OSS (MusicToolsPipeline, only needed for the OSS data loader) ---
OSS_META_DIR=
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=

# --- Lance S3 (MusicToolsPipeline, only needed for the Lance data loader) ---
LANCE_S3_ENDPOINT=
LANCE_S3_ACCESS_KEY_ID=
LANCE_S3_SECRET_ACCESS_KEY=
